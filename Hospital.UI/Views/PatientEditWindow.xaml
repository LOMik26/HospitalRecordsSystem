<Window x:Class="Hospital.UI.Views.PatientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование пациента"
        Height="400"
        Width="350"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">

        <TextBlock Text="Редактирование данных пациента"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TextBlock Text="ФИО"/>
        <TextBox x:Name="FullNameBox" Margin="0,5,0,10"/>

        <TextBlock Text="Телефон"/>
        <TextBox x:Name="PhoneBox" Margin="0,5,0,10"/>

        <TextBlock Text="Дата рождения"/>
        <DatePicker x:Name="BirthDatePicker" Margin="0,5,0,10"/>

        <TextBlock Text="Серия паспорта"/>
        <TextBox x:Name="PassportSeriesBox" Margin="0,5,0,10"/>

        <TextBlock Text="Номер паспорта"/>
        <TextBox x:Name="PassportNumberBox" Margin="0,5,0,20"/>

        <Button Content="Сохранить"
                Height="35"
                Click="Save_Click"/>

        <Button Content="Отмена"
                Height="30"
                Margin="0,10,0,0"
                Click="Cancel_Click"/>
    </StackPanel>
</Window>
