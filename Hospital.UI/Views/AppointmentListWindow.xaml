<Window x:Class="Hospital.UI.Views.AppointmentListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список приёмов"
        Height="450"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">

        <DataGrid x:Name="AppointmentsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  DockPanel.Dock="Top"
                  Height="340"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата и время" Binding="{Binding AppointmentDate, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Пациент" Binding="{Binding Patient.FullName}" Width="*"/>
                <DataGridTextColumn Header="Явка" Binding="{Binding Details.IsCame}" Width="60"/>
                <DataGridTextColumn Header="Диагноз" Binding="{Binding Details.Diagnosis}" Width="*"/>
                <DataGridTextColumn Header="Больничный" Binding="{Binding Details.SickLeaveStatus}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button x:Name="AddButton"
                    Content="Добавить"
                    Width="100"
                    Margin="5"
                    Click="Add_Click"/>

            <Button Content="Редактировать"
                    Width="120"
                    Margin="5"
                    Click="Edit_Click"/>

            <Button Content="Назад"
                    Width="100"
                    Margin="5"
                    Click="Back_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
