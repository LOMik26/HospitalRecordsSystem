<Window x:Class="Hospital.UI.Views.PatientsDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Данные пациентов"
        Height="500"
        Width="750"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox"
                     Width="300"
                     TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <DataGrid x:Name="PatientsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  DockPanel.Dock="Top"
                  Height="340"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Серия паспорта" Binding="{Binding PassportSeries}" Width="100"/>
                <DataGridTextColumn Header="Номер паспорта" Binding="{Binding PassportNumber}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button Content="Редактировать"
                    Width="120"
                    Margin="5"
                    Click="Edit_Click"/>

            <Button Content="Открыть приёмы"
                    Width="120"
                    Margin="5"
                    Click="OpenAppointments_Click"/>

            <Button Content="Удалить"
                    Width="100"
                    Margin="5"
                    Click="Delete_Click"/>

            <Button Content="Назад"
                    Width="100"
                    Margin="5"
                    Click="Back_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
