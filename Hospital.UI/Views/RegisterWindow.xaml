<Window x:Class="Hospital.UI.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация пациента"
        Height="520"
        Width="350"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="20">

            <TextBlock Text="Регистрация пациента"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Логин"/>
            <TextBox Text="{Binding Login}" Margin="0,5,0,10"/>

            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,10"/>

            <TextBlock Text="ФИО"/>
            <TextBox Text="{Binding FullName}" Margin="0,5,0,10"/>

            <TextBlock Text="Телефон"/>
            <TextBox Text="{Binding Phone}" Margin="0,5,0,10"/>

            <TextBlock Text="Дата рождения"/>
            <DatePicker SelectedDate="{Binding BirthDate}" Margin="0,5,0,10"/>

            <TextBlock Text="Серия паспорта"/>
            <TextBox Text="{Binding PassportSeries}" Margin="0,5,0,10"/>

            <TextBlock Text="Номер паспорта"/>
            <TextBox Text="{Binding PassportNumber}" Margin="0,5,0,20"/>

            <Button Content="Зарегистрироваться"
                    Height="35"
                    Click="Register_Click"/>

            <Button Content="Отмена"
                    Height="30"
                    Margin="0,10,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
