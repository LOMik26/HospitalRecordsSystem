<Window x:Class="Hospital.UI.Views.AppointmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование приёма"
        Height="560"
        Width="400"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer>
        <StackPanel Margin="20">

            <TextBlock x:Name="TitleBlock"
                       Text="Данные приёма"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Дата и время приёма"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <DatePicker x:Name="AppointmentDatePicker" Width="140" Margin="0,0,8,0"/>
                <TextBox x:Name="AppointmentTimeBox" Width="60" Text="09:00"/>
            </StackPanel>

            <CheckBox x:Name="IsCameCheckBox"
                      Content="Пациент явился"
                      Margin="0,0,0,10"
                      Checked="IsCame_Changed"
                      Unchecked="IsCame_Changed"/>

            <StackPanel x:Name="MedicalFieldsPanel">

                <TextBlock Text="Симптомы"/>
                <TextBox x:Name="SymptomsBox" Margin="0,5,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>

                <TextBlock Text="Жалобы"/>
                <TextBox x:Name="ComplaintsBox" Margin="0,5,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>

                <TextBlock Text="Диагноз"/>
                <TextBox x:Name="DiagnosisBox" Margin="0,5,0,10"/>

                <TextBlock Text="Лечение"/>
                <TextBox x:Name="TreatmentBox" Margin="0,5,0,10"/>

                <TextBlock Text="Препараты"/>
                <TextBox x:Name="MedicationsBox" Margin="0,5,0,10"/>

                <TextBlock Text="Операции"/>
                <TextBox x:Name="OperationsBox" Margin="0,5,0,10"/>

                <TextBlock Text="Статус больничного"/>
                <ComboBox x:Name="SickLeaveCombo" Margin="0,5,0,10">
                    <ComboBoxItem Content="Не выдан" Tag="None"/>
                    <ComboBoxItem Content="Выдан" Tag="Issued"/>
                </ComboBox>

            </StackPanel>

            <TextBlock Text="Комментарий"/>
            <TextBox x:Name="CommentBox" Margin="0,5,0,20" TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>

            <Button Content="Сохранить"
                    Height="35"
                    Click="Save_Click"/>

            <Button Content="Отмена"
                    Height="30"
                    Margin="0,10,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
