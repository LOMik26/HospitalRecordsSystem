<Window x:Class="Hospital.UI.Views.ApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подача заявки"
        Height="420"
        Width="350"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="Подача заявки"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TextBlock Text="ФИО"/>
        <TextBox Text="{Binding FullName}" Margin="0,5,0,10"/>

        <TextBlock Text="Телефон"/>
        <TextBox Text="{Binding Phone}" Margin="0,5,0,10"/>

        <TextBlock Text="Дата рождения"/>
        <DatePicker SelectedDate="{Binding BirthDate}" Margin="0,5,0,10"/>

        <TextBlock Text="Серия паспорта"/>
        <TextBox Text="{Binding PassportSeries}" Margin="0,5,0,10"/>

        <TextBlock Text="Номер паспорта"/>
        <TextBox Text="{Binding PassportNumber}" Margin="0,5,0,20"/>

        <TextBlock Text="Стоимость услуги: 1500 ₽"
                   FontWeight="Bold"/>

        <Button Content="Оплатить и отправить"
                Height="35"
                Margin="0,15,0,0"
                Click="Submit_Click"/>

        <Button Content="Отмена"
                Height="30"
                Margin="0,10,0,0"
                Click="Cancel_Click"/>
    </StackPanel>
</Window>
