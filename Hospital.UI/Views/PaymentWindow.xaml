<Window x:Class="Hospital.UI.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата"
        Height="300"
        Width="350"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="Оплата медицинской услуги"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TextBlock Text="Номер карты"/>
        <TextBox Margin="0,5,0,10"/>

        <TextBlock Text="Срок действия"/>
        <TextBox Margin="0,5,0,10"/>

        <TextBlock Text="CVV"/>
        <TextBox Margin="0,5,0,20"/>

        <Button Content="Оплатить"
                Height="35"
                Click="Pay_Click"/>

        <Button Content="Отмена"
                Height="30"
                Margin="0,10,0,0"
                Click="Cancel_Click"/>
    </StackPanel>
</Window>
