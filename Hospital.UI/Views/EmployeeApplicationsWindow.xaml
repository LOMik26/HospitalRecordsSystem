<Window x:Class="Hospital.UI.Views.EmployeeApplicationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заявки пациентов"
        Height="460"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">

        <DataGrid x:Name="ApplicationsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  DockPanel.Dock="Top"
                  Height="300">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Дата подачи" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Статус оплаты" Binding="{Binding PaymentStatus}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,4">
            <TextBlock Text="Дата приёма:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker x:Name="AppointmentDatePicker" Width="130" Margin="0,0,10,0"/>
            <TextBlock Text="Время (ЧЧ:ММ):" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="AppointmentTimeBox" Width="60" Text="09:00"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0">

            <Button Content="Принять"
                    Width="100"
                    Margin="5"
                    Click="Approve_Click"/>

            <Button Content="Отклонить"
                    Width="100"
                    Margin="5"
                    Click="Reject_Click"/>

            <Button Content="Закрыть"
                    Width="100"
                    Margin="5"
                    Click="Cancel_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
