<Window x:Class="Hospital.UI.Views.EmployeeApplicationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заявки пациентов"
        Height="400"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">

        <DataGrid x:Name="ApplicationsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  DockPanel.Dock="Top"
                  Height="300">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button Content="Принять"
                    Width="100"
                    Margin="5"
                    Click="Approve_Click"/>

            <Button Content="Отклонить"
                    Width="100"
                    Margin="5"
                    Click="Reject_Click"/>

            <Button Content="Закрыть"
                    Width="100"
                    Margin="5"
                    Click="Cancel_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
